# Resume Hub local environment
HUB_ENV=dev
HUB_APP_NAME="Resume Hub"
HUB_DOCS_ENABLED=true
HUB_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

HUB_MONGO_URI=mongodb://localhost:27017
HUB_MONGO_DB=resume_hub
HUB_RESUME_COLLECTION=resumes
HUB_ROLE_COLLECTION=roles
HUB_RESUME_FILES_DIR=

HUB_JWT_SECRET=replace-with-a-random-32-plus-character-secret
HUB_JWT_ALG=HS256
HUB_ACCESS_TTL_MIN=30
HUB_REFRESH_TTL_DAYS=7
HUB_LOGIN_MAX_ATTEMPTS=5
HUB_LOGIN_WINDOW_SEC=900

HUB_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
HUB_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
HUB_ENABLED_MODULES=["auth","users","job_roles","resumes","matching","admin", "email_agent", "task_review"]

# Email agent settings
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_TLS=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SENDER_NAME="Hiring Team"
EMAIL_ORG_NAME="Our Company"
EMAIL_DRY_RUN=true
EMAIL_MAX_BULK=500
