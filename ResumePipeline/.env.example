IMAP_HOST=imap.gmail.com
IMAP_USER=5your-email
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX

GEMINI_API_KEY=your-key-here  
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini 3.x only: lowest thinking level the model supports (thinking is billed as output)
GEMINI_THINKING_LEVEL=minimal

# Where resumes are stored, one file per record, named <key>.pdf / <key>.docx
RESUME_DIR=../data

# ResumeHUB MongoDB; new resumes are matched against HUB_ROLE_COLLECTION automatically
HUB_MONGO_URI=mongodb://admin:admin@localhost:27017
HUB_MONGO_DB=resume_hub
HUB_RESUME_COLLECTION=resumes
HUB_ROLE_COLLECTION=roles
# If HUB_MONGO_URI is empty, JSON goes to OUT_DIR/<key>.json instead
OUT_DIR=out

# Send a rejection only when every role's overall score is strictly below this value
EMAIL_AUTO_REJECT_SCORE_THRESHOLD=40
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_TLS=true
EMAIL_SMTP_USER=your-email
EMAIL_SMTP_PASSWORD=your-app-password
EMAIL_SENDER_NAME="Hiring Team"
EMAIL_ORG_NAME="Our Company"
EMAIL_DRY_RUN=false
