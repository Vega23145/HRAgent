IMAP_HOST=imap.gmail.com
IMAP_USER=5your-email
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX

GEMINI_API_KEY=your-key-here  
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini 3.x only: lowest thinking level the model supports (thinking is billed as output)
GEMINI_THINKING_LEVEL=minimal

# Where resumes are stored, one file per record, named <key>.pdf / <key>.docx
RESUME_DIR=../data

# JSON goes to MongoDB when MONGO_URI is set (the doc _id == the file's <key>)
MONGO_URI=mongodb://admin:admin@localhost:27017
MONGO_DB=resumes
MONGO_COLLECTION=resumes
# If MONGO_URI is empty, JSON goes to OUT_DIR/<key>.json instead
OUT_DIR=out
